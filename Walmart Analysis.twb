      <column datatype='real' name='[CPI]' role='measure' type='quantitative' />
      <column caption='Total Sales' datatype='real' name='[Calculation_1073972720984064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Weekly_Sales])' />
      </column>
      <column caption='Average Weekly Sales' datatype='real' name='[Calculation_1073972721160193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Weekly_Sales])' />
      </column>
      <column caption='Holiday Sales' datatype='real' name='[Calculation_1073972721496066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Holiday_Flag] = 1 THEN [Weekly_Sales] END&#13;&#10;)' />
      </column>
      <column caption='Sales Period' datatype='string' name='[Calculation_1073972732690435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Holiday_Flag] = 1 THEN &quot;Holiday&quot;&#13;&#10;ELSE &quot;Non-Holiday&quot;&#13;&#10;END' />
      </column>
      <column caption='Store Total Sales' datatype='real' name='[Calculation_1073972748931077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Store] : SUM([Weekly_Sales]) }' />
      </column>
      <column caption='Store Tier' datatype='string' name='[Calculation_1073972749344774]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1073972748931077] &gt;= 250000000 THEN &quot;Top Stores&quot;&#13;&#10;ELSEIF [Calculation_1073972748931077] &gt;= 150000000 THEN &quot;Mid Stores&quot;&#13;&#10;ELSE &quot;Low Stores&quot;&#13;&#10;END' />
      </column>
      <column caption='Holiday Sales Contribution %' datatype='real' name='[Calculation_1398878523170816]' role='measure' type='quantitative'>
